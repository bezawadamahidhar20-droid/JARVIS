# ── Ollama / Qwen3 ────────────────────────────────────────────────────────────
# Base URL of your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Model used as the AI brain. Install it once with:  ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b

# Seconds to wait for Ollama to answer. 120 is a safe value: the first
# request after a reboot can take ~30-60s while Qwen3 loads into RAM.
OLLAMA_TIMEOUT=120

# Creativity of the model (0.0 = strict, 1.0 = wild). 0.7 is a good default.
OLLAMA_TEMPERATURE=0.7

# ── Speech-to-text ────────────────────────────────────────────────────────────
# Language tag for Google speech recognition.
STT_LANGUAGE=en-US

# Seconds to wait for speech to start before giving up on an utterance.
STT_TIMEOUT=5

# ── Text-to-speech ────────────────────────────────────────────────────────────
# Speaking rate in words per minute (pyttsx3).
TTS_RATE=185

# ── Personality ───────────────────────────────────────────────────────────────
# What JARVIS calls you.
JARVIS_OWNER=Sir

# How many full user+assistant turns of conversation JARVIS remembers.
# Bigger = better follow-up questions, more tokens sent per request.
MEMORY_MAX_TURNS=20