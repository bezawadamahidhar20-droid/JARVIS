# ── Ollama / llama3.2 ─────────────────────────────────────────────────────────
# Base URL of your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Model used as the AI brain. Install once with:  ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# Seconds to wait for Ollama to answer. 120 is a safe value: the first
# request after a reboot can take a while while the model loads into RAM.
OLLAMA_TIMEOUT=120

# Creativity of the model (0.0 = strict, 1.0 = wild). 0.7 is a good default.
OLLAMA_TEMPERATURE=0.7

# ── SPEED: Ollama latency tuning ──────────────────────────────────────────────
# Stream tokens so the first sentence can be spoken while the rest generates.
OLLAMA_STREAM=true

# Cap response length (tokens). 150 ~= 3 short sentences. Alias: MAX_RESPONSE_TOKENS.
OLLAMA_NUM_PREDICT=150

# Context window. Smaller = faster prompt processing per request.
OLLAMA_NUM_CTX=2048

# How long to keep the model loaded in RAM (seconds or "30m"/"5m").
# Prevents the cold reload between questions.
OLLAMA_KEEP_ALIVE=30m

# Offload all layers to GPU if available. Ollama ignores this on CPU-only boxes.
OLLAMA_NUM_GPU=99

# ── Speech-to-text ────────────────────────────────────────────────────────────
# Language tag for Google speech recognition.
STT_LANGUAGE=en-US

# Seconds to wait for speech to start before giving up on an utterance.
STT_TIMEOUT=5

# Max phrase length in seconds before cutting off a long utterance.
STT_PHRASE_LIMIT=10

# ── SPEED: STT latency tuning ─────────────────────────────────────────────────
# Seconds of silence that ends a phrase (0.7 = faster cut-off than the old 1.2).
STT_SILENCE_DURATION=0.7

# Audio chunk length in seconds (0.05 = snappier speech-onset detection).
STT_CHUNK_DURATION=0.05

# Google speech API key (kept out of source code).
# GOOGLE_STT_KEY=your_google_api_key

# ── Text-to-speech ────────────────────────────────────────────────────────────
# Speaking rate in words per minute (pyttsx3).
TTS_RATE=200

# ── Personality ───────────────────────────────────────────────────────────────
# What JARVIS calls you.
JARVIS_OWNER=Sir

# How many full user+assistant turns of conversation JARVIS remembers.
# Smaller = fewer tokens sent per request = faster prompts.
MEMORY_MAX_TURNS=6

# ── SPEED: context trimming ───────────────────────────────────────────────────
# Maximum characters of conversation history sent to the model per request.
# Older turns are dropped (in pairs) when the total exceeds this.
MEMORY_MAX_CHARS=3000

# ── SPEED: misc ───────────────────────────────────────────────────────────────
# Reply to greetings instantly from a local table (no AI round-trip).
ENABLE_FAST_RESPONSES=true

# Pre-load the model in a background thread at startup.
ENABLE_WARMUP=true