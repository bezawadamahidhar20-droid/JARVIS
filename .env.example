# ── JARVIS configuration template ─────────────────────────────────────────────
# Copy to .env and edit:   Copy-Item .env.example .env
# All values have working defaults, so this file is optional.

# ── AI brain (Ollama) ─────────────────────────────────────────────────────────
# Base URL of your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Model used as the AI brain. Install once with:  ollama pull qwen3:8b
#
# SPEED: on CPU-only machines qwen3:8b generates ~2-3 tokens/s, so a
# 3-sentence answer takes 20-40 s. The models below are ALREADY faster
# (measured on a CPU-only laptop, all warm):
#   llama3.2:3b  ~2.2x faster than qwen3:8b (best quality/speed)
#   qwen3:1.7b   ~2.3x faster, smallest (good for weak CPUs)
# Switch with one line and keep everything else identical:
#   OLLAMA_MODEL=llama3.2:3b
OLLAMA_MODEL=qwen3:8b

# Seconds to wait for Ollama to answer. 120 is a safe value: the first
# request after a reboot can take a while while the model loads into RAM.
OLLAMA_TIMEOUT=120

# Creativity of the model (0.0 = strict, 1.0 = wild).
OLLAMA_TEMPERATURE=0.7

# ── MODEL MODE: fast vs quality ───────────────────────────────────────────────
# Pick which Ollama model JARVIS uses without editing OLLAMA_MODEL:
#   quality — OLLAMA_QUALITY_MODEL, falling back to OLLAMA_MODEL (default)
#   fast    — OLLAMA_FAST_MODEL,     falling back to OLLAMA_MODEL
# Leave both *_MODEL vars empty to always use OLLAMA_MODEL (current behavior).
# Find the best model for your machine with:  jarvis --benchmark-models
JARVIS_MODEL_MODE=quality
OLLAMA_FAST_MODEL=qwen3:1.7b
OLLAMA_QUALITY_MODEL=qwen3:8b

# ── SPEED: Ollama latency tuning ──────────────────────────────────────────────
# Stream tokens so the first sentence can be spoken while the rest generates.
OLLAMA_STREAM=true

# Suppress Qwen3 "thinking" tokens for fast voice replies.
OLLAMA_THINK=false

# Cap response length (tokens). 120 ~= 3-4 short spoken sentences;
# bounds the worst-case wait on slow CPUs. Alias: MAX_RESPONSE_TOKENS.
OLLAMA_NUM_PREDICT=120

# Context window. Smaller = faster prompt processing per request.
OLLAMA_NUM_CTX=2048

# How long to keep the model loaded in RAM (seconds or "30m"/"5m").
OLLAMA_KEEP_ALIVE=30m

# Offload all layers to GPU if available. Ollama ignores this on CPU-only boxes.
OLLAMA_NUM_GPU=99

# ── Ollama circuit breaker ────────────────────────────────────────────────────
# If Ollama becomes unresponsive mid-session, every request would otherwise
# block for OLLAMA_TIMEOUT. The breaker fast-fails ("AI offline") after
# OLLAMA_CIRCUIT_THRESHOLD consecutive failures and auto-recovers once
# Ollama comes back. Set OLLAMA_CIRCUIT_BREAKER=false to disable.
OLLAMA_CIRCUIT_BREAKER=true
OLLAMA_CIRCUIT_THRESHOLD=3
OLLAMA_CIRCUIT_RECOVERY=30

# ── Speech-to-text (Faster-Whisper, fully local) ──────────────────────────────
# Model size: "tiny" (fastest) | "base" (default) | "small" | "medium".
# The model is downloaded automatically on first run (~150 MB for base).
WHISPER_MODEL=base

# "int8" for CPU (default), "float16" for CUDA GPUs.
WHISPER_COMPUTE_TYPE=int8

# "auto" (default) uses CUDA when available and falls back to CPU —
# machines without an NVIDIA GPU never crash. Force with "cpu"/"cuda".
WHISPER_DEVICE=auto

# Whisper language code ("en", "es", "fr", ...).
WHISPER_LANGUAGE=en

# 1 = greedy decoding (fast); higher = slower but more accurate.
WHISPER_BEAM_SIZE=1

# ── Audio capture / VAD ───────────────────────────────────────────────────────
# Sample rate for capture (Whisper expects 16 kHz).
SAMPLE_RATE=16000

# Optional numeric input device index (0, 1, ...). Leave empty for the
# system default microphone. Find indices with:  jarvis --doctor
# INPUT_DEVICE=0

# Seconds to wait for speech to start before giving up on an utterance.
STT_TIMEOUT=5

# Max phrase length in seconds before cutting off a long utterance.
STT_PHRASE_LIMIT=10

# Seconds of ambient noise sampled at startup to calibrate the speech
# threshold (adaptive VAD). 0 disables calibration.
VAD_CALIBRATE_SECONDS=0.6

# Speech threshold = max(VAD_MIN_THRESHOLD, ambient_rms * this).
VAD_THRESHOLD_MULTIPLIER=3.0

# Absolute floor for the speech threshold (RMS units).
VAD_MIN_THRESHOLD=120

# Seconds of silence that ends a phrase (0.7 = fast cut-off).
VAD_SILENCE_DURATION=0.7

# Audio chunk length in seconds (0.05 = snappy speech-onset detection).
VAD_CHUNK_DURATION=0.05

# Ignore utterances shorter than this many speech chunks (noise blips).
VAD_MIN_SPEECH_CHUNKS=3

# ── Text-to-speech (Piper, fully local) ───────────────────────────────────────
# "piper" (neural, recommended) or "pyttsx3" (Windows SAPI5 fallback).
TTS_ENGINE=piper

# Piper voice name — must exist as voices/<name>.onnx.
# Download with:  python -m piper.download_voices en_US-lessac-medium
TTS_VOICE=en_US-lessac-medium

# Optional explicit path to the voice ONNX file (overrides TTS_VOICE).
# TTS_VOICE_PATH=C:\path\to\voice.onnx

# Piper synthesis tuning (leave defaults unless it sounds off).
TTS_LENGTH_SCALE=1.0
TTS_NOISE_SCALE=0.667
TTS_NOISE_W=0.8

# pyttsx3 fallback settings (only used when TTS_ENGINE=pyttsx3).
TTS_RATE=200

# ── Personality ───────────────────────────────────────────────────────────────
# What JARVIS calls you.
JARVIS_OWNER=Sir

# Which AI provider to use: "ollama" (default; Groq auto-fallback when
# GROQ_API_KEY is set) or "groq" (Groq only).
AI_PROVIDER=ollama

# ── Answer mode (current information vs local knowledge) ──────────────────────
#   auto  — decide per question whether fresh info is needed (recommended)
#   local — always answer from the local LLM (never searches)
#   web   — always search the web before answering
AI_MODE=auto

# ── Web search (current information) ───────────────────────────────────────────
# When a question needs fresh facts (politics, news, weather, prices, sports,
# software versions, ...), JARVIS searches the web and answers from the
# retrieved results instead of relying on the model's training data.
#
# Provider: "tavily" | "serper" | "brave". Get a free API key from the
# provider's site and paste it below. Leave SEARCH_API_KEY empty to disable
# web search (current-information questions will answer "cannot verify").
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Max results fetched per search (3-10).
SEARCH_MAX_RESULTS=5

# Seconds identical queries are served from the in-memory cache (0 = off).
SEARCH_CACHE_TTL=300

# Upper bound on cached queries (oldest evicted first).
SEARCH_CACHE_MAX_ENTRIES=50

# ── Groq fallback (optional) ────────────────────────────────────────────────
# When Ollama is unavailable, JARVIS can answer through Groq if a key is
# set here. Leave empty to disable (Ollama-only operation).
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=60
GROQ_MAX_TOKENS=200

# ── Conversation memory ───────────────────────────────────────────────────────
# How many full user+assistant turns of conversation JARVIS remembers.
MEMORY_MAX_TURNS=6

# Maximum characters of conversation history sent to the model per request.
MEMORY_MAX_CHARS=3000

# Persist conversation history across restarts (JSON file, gitignored).
# Set MEMORY_PERSIST=false for a memory that forgets on exit.
MEMORY_PERSIST=true
MEMORY_FILE=data/conversation.json

# ── Input limits ───────────────────────────────────────────────────────────────
# Max characters accepted per utterance (longer input is rejected politely).
JARVIS_MAX_INPUT_CHARS=500

# Seconds a shutdown/restart/sleep confirmation stays valid before expiring.
CONFIRMATION_TIMEOUT=30

# When true, destructive confirmations require you to echo a random nonce
# code ("say the code a3f2 to confirm") before they execute — a stray "yes"
# from another process can never authorize the action.
CONFIRMATION_REQUIRE_TOKEN=false

# ── SPEED: misc ───────────────────────────────────────────────────────────────
# Reply to greetings instantly from a local table (no AI round-trip).
ENABLE_FAST_RESPONSES=true

# Pre-load the model in a background thread at startup.
ENABLE_WARMUP=true

# Streaming STT: transcribe 3-second windows while you are still speaking
# and feed partial results to the router (early "stop" detection, faster
# perceived response). Costs extra CPU on CPU-only machines — off by default.
STT_STREAM=false

# ── Wake word (optional) ─────────────────────────────────────────────────────
# When enabled, JARVIS only listens after "hey jarvis" instead of always-on
# VAD. Requires: pip install openwakeword  (the model downloads on first
# use). If the package or model is missing, JARVIS falls back to always-on.
ENABLE_WAKE_WORD=false
JARVIS_WAKE_WORD=hey jarvis

# ── Barge-in (optional) ──────────────────────────────────────────────────────
# Monitor the microphone while JARVIS is speaking and interrupt TTS the
# moment you talk. Needs a quiet room / echo handling — off by default.
ENABLE_BARGE_IN=false

# Console log level: INFO (default) or DEBUG. `jarvis --debug` overrides.
LOG_LEVEL=INFO
